{
  "description": "Keep clean-room work away from prey and block unsafe prey-cache shell commands.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "crab-cleanroom-guard",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "crab-prey-guard",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
