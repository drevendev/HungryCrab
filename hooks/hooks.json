{
  "description": "Keep the clean-room implementer out of Hungry Crab's prey cache.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/src/hungry_crab/cleanroom_guard.py"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
